{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=14.8.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:watch": "concurrently \"npm:build:watch:*\" --kill-others",
    "build:watch:country": "cd packages/country && pnpm build:watch",
    "build:watch:geocode": "cd packages/geocode && pnpm build:watch",
    "build:watch:maxmind": "cd packages/maxmind && pnpm build:watch",
    "build:watch:core": "cd packages/core && pnpm build:watch",
    "test:ui": "vitest --ui --coverage",
    "test": "vitest --run --coverage",
    "release:all": "pnpm install && pnpm build && pnpm -r release"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.9.1",
    "@rollup/plugin-replace": "^6.0.1",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^3.2.6",
    "@vitest/ui": "^3.2.6",
    "bumpp": "^9.8.1",
    "concurrently": "^9.0.1",
    "eslint": "^9.11.1",
    "eslint-plugin-format": "^0.1.2",
    "semver": "^7.6.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-dts": "^4.2.2",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.11": "1.1.20",
      "brace-expansion@2.0.1": "2.1.6",
      "browserslist@4.24.2": "4.28.7",
      "defu@6.1.4": "6.1.5",
      "fflate@0.8.2": "0.8.3",
      "flatted@3.3.2": "3.4.2",
      "glob@10.4.5": "10.5.0",
      "js-yaml@4.1.0": "4.3.2",
      "lodash@4.17.21": "4.18.0",
      "minimatch@3.0.8": "3.1.4",
      "minimatch@3.1.2": "3.1.4",
      "minimatch@9.0.5": "9.0.7",
      "nanoid@3.3.7": "3.3.18",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.2": "4.0.4",
      "postcss@8.4.49": "8.5.18",
      "rollup@4.27.3": "4.59.0",
      "shell-quote@1.8.1": "1.11.0",
      "source-map-js@1.2.1": "1.2.2"
    }
  }
}
